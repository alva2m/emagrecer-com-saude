      <a href="#beneficios">Benefícios</a>
      <a href="#faq">Dúvidas</a>
    </nav>

    <a href="#produto" class="btn">CONHECER O E-BOOK ↗</a>
  </div>
</header>

<main>

<section class="hero" id="inicio">
  <div class="container hero-grid">

    <div>
      <div class="eyebrow">UM NOVO OLHAR SOBRE SEUS HÁBITOS</div>

      <h1>
        Cuide de você.<br>
        Transforme seus <em>hábitos.</em><br>
